# ============================================================
# VittaSetu backend — environment variables
# Never commit this file. It is already listed in .gitignore.
# ============================================================

PORT=5000

# Used to sign login tokens (JWT). Replace with your own long random string
# before deploying anywhere beyond your laptop.
JWT_SECRET=change-this-to-a-long-random-string-before-deploying

# SQLite database file (created automatically on first run)
DB_PATH=./data/vittasetu.db

# Samarth AI assistant — OpenRouter API key
# IMPORTANT: this key was pasted into a chat, which means it may already be
# logged somewhere outside your control. Treat it as compromised and
# generate a fresh key at https://openrouter.ai/keys, then paste the NEW
# key here. Never put this key in any frontend/browser file — it must only
# ever be read by this backend (see routes/chat.js).
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openai/gpt-4o-mini
